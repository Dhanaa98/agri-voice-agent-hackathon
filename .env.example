# AssemblyAI streaming ASR
ASSEMBLYAI_API_KEY=

# Google Gemini free tier
GEMINI_API_KEY=

# OpenWeatherMap free tier
OPENWEATHER_API_KEY=

# Default location for weather/crop lookups (city name or "lat,lon")
DEFAULT_LOCATION=Colombo,LK

# ElevenLabs -- used by tools/generate_wakeword_tts.py (a local
# training-data script; reads this same var independently, not via
# config.py -- see that script's own docstring) AND, on the elevenlabs-tts
# branch only (not master), by the live app itself for cloud text-to-
# speech spoken replies instead of the browser's free speechSynthesis
# (see tts_client.py). The same ElevenLabs account/key can serve both
# uses.
ELEVENLABS_API_KEY=

# elevenlabs-tts branch only (not master). A real voice_id from your
# ElevenLabs account's Voices list (https://elevenlabs.io/app/voice-library)
# -- there's no safe default to guess, since which voices exist depends on
# the account. Leaving this blank keeps the app on free browser
# speechSynthesis even if ELEVENLABS_API_KEY above is set.
ELEVENLABS_VOICE_ID=
